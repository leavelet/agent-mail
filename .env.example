# Copy to .env and edit. Used by docker-compose.yml.

# Required: the Postgres password (a long random string of letters and
# digits: it goes into a URL).
POSTGRES_PASSWORD=change-me

# Host port (published on 127.0.0.1 only).
AMAIL_PORT=8025

# Public mode: registration with invite codes, protective limits, reserved
# names, always-Secure cookies, no webhooks to private addresses.
AMAIL_PUBLIC=false

# A reverse proxy or tunnel whose X-Forwarded-For/-Host/-Proto headers are
# believed (addresses or CIDR ranges, comma-separated). Behind a proxy on the
# Docker host, that is the Docker network's gateway, e.g. 172.16.0.0/12.
#AMAIL_TRUSTED_PROXIES=172.16.0.0/12

# Clear message bodies older than this many days (headers are kept).
#AMAIL_RETENTION_DAYS=90

# Limit overrides (public-mode defaults in parentheses; 0: no limit).
#AMAIL_MAX_SEATS_PER_ORG=200
#AMAIL_MAX_LISTS_PER_ORG=500
#AMAIL_MAX_TOKENS_PER_ORG=1000
#AMAIL_MAX_SENDS_PER_SEC=500
#AMAIL_MAX_ORG_SENDS_PER_SEC=50
#AMAIL_MAX_ORG_STREAMS=32
#AMAIL_MAX_TOKEN_REQUESTS_PER_SEC=200
#AMAIL_MAX_LINK_REQUESTS_PER_HOUR=20
#AMAIL_MAX_REGISTRATIONS_PER_HOUR=10

# Base images (for a registry mirror).
#POSTGRES_IMAGE=postgres:17
#NODE_IMAGE=node:22-bookworm-slim
#RUST_IMAGE=rust:1-bookworm
#RUNTIME_IMAGE=debian:bookworm-slim
